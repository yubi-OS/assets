// yubiOS boot sound v3g: v3e with the white floor high-passed at 400 Hz (flatness and beta) and the heavier pink floor from v2e (complexity)
setcpm(60) // 1 cycle = 1 second, 10 s total

// 0a. full-band air: white noise at a mid level, swelling with the arrival
$: s("white").hpf(400).gain("<.075 .085 .09 .095 .10 .10 .105 .11>")

// 0b. warm air: band-limited pink noise, swelling more than the floor
$: s("pink").hpf(60).room(.4).gain("<.06 .08 .10 .12 .14 .16 .18 .20>")

// 1. power-on hum: low sine, slow swell
$: note("[c2@16]/8").s("sine").attack(1.4).release(1.8).gain(.26)

// 2. verification ladder: minor-pentatonic bells in the C4 register, two per second
$: n("[0 2 4 6 7 9 11 12]*2/8").scale("C4:minor:pentatonic")
  .s("triangle").attack(.005).release(.9).lpf(1600).room(.6).gain("<.10 .14 .18 .22 .26 .28 .30 .32>")

// 3. trust pad: jazz-minor voicings, quiet start to full arrival
$: note("[[c3,eb3,g3,bb3,d4] [c3,eb3,g3,bb3,d4] [ab2,c3,eb3,g3] [ab2,c3,eb3,g3] [f3,ab3,c4,eb4,g4] [f3,ab3,c4,eb4,g4] [g2,b2,d3,f3,a3] [c3,e3,g3,b3,d4]]/8")
  .s("sawtooth").lpf("<520 580 640 700 760 820 880 940>")
  .attack(.7).release(1.6).room(.7).gain("<.02 .04 .07 .10 .14 .18 .24 .32>")

// 4. confirmation bell: g5 at 6 s with a long tail (root of trust confirmed)
$: note("[~ ~ ~ ~ ~ ~ g5 ~]/8").s("triangle").attack(.005).release(3).room(.9).lpf(2200).gain(.46)
