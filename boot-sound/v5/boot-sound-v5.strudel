// yubiOS boot sound v5d: challenge and response, then a joint confirmation. Taps, a wait for touch, a falling answer from
// the far side, an accelerating heartbeat, the challenge echoed back, a verification climb across the field, and a
// confirmation strike at second 7 where every voice lands together and rings out.
setcpm(60) // 1 cycle = 1 second, 10 s total

// 0a. air: pink bed, swelling through the answer, then ringing out
$: s("pink").hpf(60).room(.5).gain("<.02 .03 .04 .06 .08 .10 .12 .12 .10 .08>")

// 0b. air: white floor, high-passed, from the answer on
$: s("white").hpf(400).gain("<.01 .01 .02 .03 .05 .07 .08 .09 .08 .06>")

// 1. the hum: quiet, holds the root under the sequence
$: note("[c2@16]/8").s("sine").attack(1.4).release(1.8).gain(.09)

// 2. challenge: three rising taps on the left, then silence while the key waits for touch
$: note("<c4 e4 g4 ~ ~ ~ ~ ~ ~ ~>").s("sine").attack(.005).decay(.25).sustain(0).release(.5).pan(.15).room(.5).gain(.34)

// 3. response: a falling answer from the far side, an octave up
$: note("<~ ~ ~ g5 e5 c5 ~ ~ ~ ~>").s("triangle").attack(.01).release(1.2).pan(.85).room(.6).gain(.30)

// 4. heartbeat: starts after the wait, accelerating from one to three beats a second, then stops before the strike
$: note("<~ ~ ~ c1 [c1 c1] [c1 c1 c1] c1 ~ ~>").s("sine").attack(.001).decay(.16).sustain(0).release(.05).lpf(200)
  .gain("<0 0 0 .10 .12 .13 .14 0 0 0>")

// 5. verification climb: bells two per second in a major pentatonic, moving across the field
$: n("[0 2 4 6 7 9 11 12]*2/8").scale("C4:major:pentatonic")
  .s("triangle").attack(.005).release(.9).lpf(2400).room(.6)
  .pan(sine.slow(4).range(.2,.8)).gain("<0 0 0 0 .14 .20 .26 0 0 0>")

// 5b. echo: the challenge comes back, quieter, at the centre, just before the strike
$: note("<~ ~ ~ ~ ~ ~ c4 e4 ~ ~>").s("sine").attack(.005).decay(.25).sustain(0).release(.5).pan(.5).room(.5).gain(.20)

// 6. trust pad: Am7, Fmaj9, G7, then Cmaj9 that strikes at second 7 and fades through the last seconds
$: note("<~ ~ ~ ~ [a2,c3,e3,g3] [f2,a2,c3,e3,g3] [g2,b2,d3,f3,a3] [c3,e3,g3,b3,d4] [c3,e3,g3,b3,d4] [c3,e3,g3,b3,d4]>")
  .s("sawtooth").lpf("<400 400 400 400 600 800 1100 2000 1600 1200>")
  .attack(.6).release(1.4).room(.7).pan(.5).gain("<0 0 0 0 .10 .18 .26 .40 .30 .18>")

// 6b. shimmer: the same chord an octave up in triangle, joining the strike and fading
$: note("<~ ~ ~ ~ ~ ~ ~ [c4,e4,g4,b4,d5] [c4,e4,g4,b4,d5] [c4,e4,g4,b4,d5]>")
  .s("triangle").attack(.02).release(1.6).room(.8).pan(.3).gain("<0 0 0 0 0 0 0 .18 .14 .08>")

// 7. resolution: a low C under the chord, ringing out
$: note("<~ ~ ~ ~ ~ ~ ~ c2 ~ ~>").s("sine").attack(.01).release(3).gain(.24)

// 8. confirmation strike: the bell lands with the chord at second 7 in the centre and rings to the end
$: note("<~ ~ ~ ~ ~ ~ ~ [c5,g5] ~ ~>").s("triangle").attack(.005).release(3).room(.9).lpf(2600).pan(.5).gain(.60)
