// yubiOS boot sound v2i: v2h with a higher white floor and a darker confirmation bell
setcpm(60) // 1 cycle = 1 second, 10 s total

// 0a. full-band air: quiet white noise, swelling with the pad
$: s("white").gain("<.06 .065 .07 .07 .075 .075 .08 .08>")

// 0b. warm air: band-limited pink noise, swelling with the pad
$: s("pink").hpf(60).room(.4).gain("<.06 .08 .10 .12 .14 .16 .18 .20>")

// 1. power-on hum: low sine, slow swell
$: note("[c2@16]/8").s("sine").attack(1.4).release(1.8).gain(.26)

// 2. verification ladder: minor-pentatonic bells in the C4 register, darker
$: n("[0 2 4 6 7 9 11 12]*2/8").scale("C4:minor:pentatonic")
  .s("triangle").attack(.005).release(.9).lpf(1400).room(.6).gain(.30)

// 3. trust pad: jazz-minor voicings, darker filter, wider swell
$: note("[[c3,eb3,g3,bb3,d4] [c3,eb3,g3,bb3,d4] [ab2,c3,eb3,g3] [ab2,c3,eb3,g3] [f3,ab3,c4,eb4,g4] [f3,ab3,c4,eb4,g4] [g2,b2,d3,f3,a3] [c3,e3,g3,b3,d4]]/8")
  .s("sawtooth").lpf("<480 520 560 600 640 680 720 760>")
  .attack(.7).release(1.6).room(.7).gain("<.05 .08 .11 .14 .17 .21 .26 .32>")

// 4. confirmation bell: g5 at 6 s with a long tail (root of trust confirmed)
$: note("[~ ~ ~ ~ ~ ~ g5 ~]/8").s("triangle").attack(.005).release(3).room(.9).lpf(1400).gain(.36)
